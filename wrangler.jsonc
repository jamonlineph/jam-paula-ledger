{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jam-paula-ledger",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/healthz"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ledger", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "SHEET_URL": "https://docs.google.com/spreadsheets/d/1v4DRN26RU83FICABoXKUs0T_uQ_6MEgdCbprSSXPsPA/edit",
    "TZ": "America/Edmonton"
  },
  "observability": { "enabled": true }
}
